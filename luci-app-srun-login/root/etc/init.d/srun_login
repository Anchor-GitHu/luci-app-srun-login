#!/bin/sh /etc/rc.common
# SRUN 校园网开机自动登录
# 读取 UCI 中保存的账号与加密密码，解密后调用后端脚本登录
START=99

UCI_CONF="srun_login"
LOG_FILE="/var/log/srun_login.log"

log_msg() {
	local ts
	ts=$(date "+%Y-%m-%d %H:%M:%S")
	echo "[$ts] $1" >> "$LOG_FILE" 2>/dev/null
}

# 获取设备密钥（与控制器 luci.controller.srun_login 的 get_device_key 完全一致）
get_device_key() {
	local mac
	# 只删冒号和换行/回车/制表符，不用 POSIX 字符类（busybox tr 对 [:space:] 解析有 bug，会误删十六进制字符）
	mac=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':\r\n\t ')
	if [ -z "$mac" ]; then
		mac=$(awk 'NR==1{print}' /sys/class/net/eth*/address 2>/dev/null | tr -d ':\r\n\t ')
	fi
	if [ -z "$mac" ]; then
		mac="srun-default-key-2024"
	fi
	echo "$mac"
}

# XOR 解密：hex 字符串 + 密钥 -> 明文
# 直接调用 Lua，复用控制器 luci.controller.srun_login 中验证过的 xor_crypt/hex_decode 逻辑，保证与加密端一致
# 通过环境变量传递参数，避免不同 Lua 版本 arg 表的兼容差异
decrypt_pwd() {
	local enc="$1"
	local key="$2"
	[ -z "$enc" ] && { echo ""; return; }
	SRUN_ENC="$enc" SRUN_KEY="$key" lua <<'LUAEOF'
local enc = os.getenv("SRUN_ENC") or ""
local key = os.getenv("SRUN_KEY") or ""

-- 十六进制解码（与控制器 hex_decode 一致）
local function hex_decode(s)
	if not s or s == "" then return "" end
	return (s:gsub("%x%x", function(h) return string.char(tonumber(h, 16)) end))
end

-- 单字节按位异或（与控制器 byte_xor 一致，Lua 5.1 兼容纯算术实现）
local function byte_xor(a, b)
	local r = 0
	local bit_val = 1
	for _ = 1, 8 do
		local ba = a % 2
		local bb = b % 2
		if ba ~= bb then r = r + bit_val end
		a = math.floor(a / 2)
		b = math.floor(b / 2)
		bit_val = bit_val * 2
	end
	return r
end

-- XOR 解密（与控制器 xor_crypt 一致，密钥循环异或）
local function xor_crypt(data, key)
	if key == "" then return data end
	local klen = #key
	local out = {}
	for i = 1, #data do
		local b = data:byte(i)
		local kb = key:byte(((i - 1) % klen) + 1)
		out[i] = string.char(byte_xor(b, kb))
	end
	return table.concat(out)
end

io.write(xor_crypt(hex_decode(enc), key))
LUAEOF
}

start() {
	# 遍历已保存账号，找到标记 autologin=1 的账号
	local idx username enc_pwd operator login_name key auto
	idx=0
	username=""
	while :; do
		local uname
		uname=$(uci -q get "$UCI_CONF".@account["$idx"].username 2>/dev/null)
		[ -z "$uname" ] && break
		auto=$(uci -q get "$UCI_CONF".@account["$idx"].autologin 2>/dev/null)
		if [ "$auto" = "1" ]; then
			username="$uname"
			enc_pwd=$(uci -q get "$UCI_CONF".@account["$idx"].password 2>/dev/null)
			operator=$(uci -q get "$UCI_CONF".@account["$idx"].operator 2>/dev/null)
			break
		fi
		idx=$((idx+1))
	done

	if [ -z "$username" ]; then
		log_msg "开机自动登录：没有账号被标记为开机登录，跳过"
		return 0
	fi

	if [ -z "$enc_pwd" ]; then
		log_msg "开机自动登录：账号 $username 缺少密码，跳过"
		return 0
	fi

	key=$(get_device_key)
	password=$(decrypt_pwd "$enc_pwd" "$key")

	login_name="$username"
	[ -n "$operator" ] && login_name="${username}@${operator}"

	# 等待网络就绪：最多轮询 60 秒，直到能访问认证服务器
	local tries=0
	while [ $tries -lt 60 ]; do
		if ping -c 1 -W 2 202.201.252.10 >/dev/null 2>&1; then
			break
		fi
		tries=$((tries+1))
		sleep 1
	done

	log_msg "开机自动登录：$login_name"

	local out
	out=$(python3 /usr/bin/SRUN_Login/srun_login.py --username "$login_name" --password "$password" 2>&1)
	log_msg "登录结果：$out"
}

stop() {
	return 0
}
